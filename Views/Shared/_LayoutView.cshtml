<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - Student Feedback Form</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />


    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: #f0fdfa;
            font-family: Arial, Helvetica, sans-serif;
            color: #334155;
        }

        /* Header */
        .main-header {
            background: linear-gradient(120deg, #115e59, #0d9488);
            color: white;
            padding: 24px 0;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.12);
        }

            .main-header h2 {
                margin: 0;
                font-size: 28px;
                font-weight: 700;
            }

        .header-subtitle {
            margin: 6px 0 0;
            color: #ccfbf1;
            font-size: 14px;
        }

        /* Navigation */
        .main-nav {
            background-color: white;
            border-bottom: 1px solid #ccfbf1;
        }

            .main-nav a {
                display: inline-block;
                padding: 14px 12px;
                color: #334155;
                font-weight: 600;
                text-decoration: none;
                transition: color 0.2s;
            }

                .main-nav a:hover {
                    color: #0d9488;
                }

        /* Main content */
        .main-content {
            flex: 1;
            padding-top: 38px;
            padding-bottom: 45px;
        }

        .page-card {
            background-color: white;
            padding: 30px;
            border-radius: 14px;
            box-shadow: 0 5px 22px rgba(15, 118, 110, 0.08);
        }

        .page-heading {
            color: #115e59;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .page-subheading {
            color: #64748b;
            font-size: 22px;
            margin-bottom: 28px;
        }

        /* Form controls */
        .form-label {
            color: #334155;
            font-weight: 600;
        }

        .form-control,
        .form-select {
            padding: 11px 13px;
            border-radius: 8px;
            border-color: #99f6e4;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #0d9488;
                box-shadow: 0 0 0 0.2rem rgba(13, 148, 136, 0.15);
            }

        .btn {
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 600;
        }

        .btn-primary {
            background-color: #0f766e;
            border-color: #0f766e;
        }

            .btn-primary:hover {
                background-color: #115e59;
                border-color: #115e59;
            }

        /* Feedback table */
        .feedback-table th {
            background-color: #115e59;
            color: white;
            white-space: nowrap;
        }

        .feedback-table th,
        .feedback-table td {
            padding: 14px;
            vertical-align: middle;
        }

        /* Footer */
        .main-footer {
            margin-top: auto;
            padding: 20px 0;
            background-color: #134e4a;
            color: white;
            text-align: center;
        }

            .main-footer p {
                margin: 0;
                font-size: 15px;
            }

        /* Validation messages */
        .field-validation-error {
            display: block;
            margin-top: 5px;
            color: #dc3545;
            font-size: 13px;
        }

        .validation-summary-errors {
            color: #dc3545;
        }

            .validation-summary-errors ul {
                margin-bottom: 0;
            }

        /* Mobile responsive styles */
        @@media (max-width: 576px) {
            .main-header h2 {
                font-size: 23px;
            }

            .main-content {
                padding-top: 22px;
                padding-bottom: 25px;
            }

            .page-card {
                padding: 20px 16px;
            }

            .page-subheading {
                font-size: 18px;
            }

            .main-nav a {
                padding: 12px 7px;
                font-size: 14px;
            }
        }
    </style>

</head>

<body>

    <!-- Common Header -->
    <header class="main-header">
        <div class="container">
            <h2>Student Feedback Form</h2>
            <p class="header-subtitle">
                Your feedback helps us improve.
            </p>
        </div>
    </header>

    <!-- Common Navigation -->
    <nav class="main-nav">
        <div class="container">
            <a href="@Url.Action("Index", "Feedback")">
                Home
            </a>

            <a href="@Url.Action("Create", "Feedback")">
                Give Feedback
            </a>

            <a href="@Url.Action("List", "Feedback")">
                View Feedback
            </a>
        </div>
    </nav>

    <!-- Page-specific Content -->
    <main class="main-content">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Common Footer -->
    <footer class="main-footer">
        <div class="container">
            <p>Marwadi University 2026</p>
        </div>
    </footer>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Optional scripts defined by individual views -->
    @RenderSection("Scripts", required: false)

</body>
</html>